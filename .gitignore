# Observational data (download from Zenodo, see data/README.md) and the processed corpus
data/urban-plumber/FullCollection/
data/urban-plumber/*.zip
data/urban-plumber/corpus/
data/urban-plumber/corpus_index.json

# TEB source tree and raw model-run output regenerated by the run scripts (large; not redistributed).
# Only the namelists and the baseline LW-up output per record are tracked.
external/teb/
external/teb_runs/*/input/
external/teb_runs/*/output/*
!external/teb_runs/*/output/LWU_base.txt
external/teb_runs/*/driver*.log
external/teb_runs/*/closure*.txt
external/teb_albedo19/*/*
!external/teb_albedo19/*/input.nml
external/teb_spinup10/*/*
!external/teb_spinup10/*/input.nml
external/teb_probe/*/*
!external/teb_probe/*/input.nml
external/clmu_baseline19/
external/clmu_albedo19/
external/clmu_spinup19/
external/clmu_verify/
external/clmu_g1/*/clm2_history.nc

# scratch directory used by the review6 verification scripts (SCR)
scratch/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
